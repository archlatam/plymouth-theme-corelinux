name="corelinux"

post_install() {
	echo "==> Setting Plymouth theme: $name"
	plymouth-set-default-theme -R "$name"
}

post_upgrade() {
	if grep -q "^Theme=$name" /etc/plymouth/plymouthd.conf 2>/dev/null; then
		plymouth-set-default-theme -R "$name"
	fi
}

pre_remove() {
	if grep -q "^Theme=$name" /etc/plymouth/plymouthd.conf 2>/dev/null; then
		cat <<_EOF

==> WARNING: you are removing your current Plymouth theme.
==> Set a different theme with:
==> sudo plymouth-set-default-theme -R <theme-name>

_EOF
	fi
}
