Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ---------- Animación ----------
frame_count = 145;
for (i = 0; i < frame_count; i++)
    frames[i] = Image("frame-" + String(Math.Int(i / 100)) + String(Math.Int((i % 100) / 10)) + String(i % 10) + ".png");

sprite = Sprite();
anim_x = screen_w / 2 - frames[0].GetWidth() / 2;
anim_y = screen_h / 2 - frames[0].GetHeight() / 2 - screen_h / 10;
sprite.SetPosition(anim_x, anim_y, 0);

progress = 0;
fun refresh_callback() {
    sprite.SetImage(frames[progress % frame_count]);
    progress++;
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---------- Contraseña (LUKS) ----------
entry_image  = Image("entry.png");
bullet_image = Image("bullet.png");
entry_x = screen_w / 2 - entry_image.GetWidth() / 2;
entry_y = anim_y + frames[0].GetHeight() + screen_h / 20;

entry_sprite = Sprite(entry_image);
entry_sprite.SetPosition(entry_x, entry_y, 10);
entry_sprite.SetOpacity(0);

label_sprite = Sprite();
label_sprite.SetOpacity(0);

max_bullets = 20;
for (i = 0; i < max_bullets; i++) {
    bullets[i] = Sprite(bullet_image);
    bullets[i].SetOpacity(0);
}

fun hide_password() {
    entry_sprite.SetOpacity(0);
    label_sprite.SetOpacity(0);
    for (i = 0; i < max_bullets; i++)
        bullets[i].SetOpacity(0);
}

fun password_callback(prompt, bullet_count) {
    label = Image.Text(prompt, 0.6, 0.78, 1.0);
    label_sprite.SetImage(label);
    label_sprite.SetPosition(screen_w / 2 - label.GetWidth() / 2, entry_y - label.GetHeight() - 12, 10);
    label_sprite.SetOpacity(1);
    entry_sprite.SetOpacity(1);
    if (bullet_count > max_bullets) bullet_count = max_bullets;
    start_x = screen_w / 2 - (max_bullets * 20) / 2 + 2;
    for (i = 0; i < max_bullets; i++) {
        bullets[i].SetPosition(start_x + i * 20, entry_y + entry_image.GetHeight() / 2 - bullet_image.GetHeight() / 2, 11);
        if (i < bullet_count) bullets[i].SetOpacity(1);
        else bullets[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(hide_password);

# ---------- Mensajes ----------
msg_sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 1, 1, 1);
    msg_sprite.SetImage(img);
    msg_sprite.SetPosition(screen_w / 2 - img.GetWidth() / 2, screen_h - 60, 10);
}
Plymouth.SetMessageFunction(message_callback);
